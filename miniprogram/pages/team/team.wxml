<!-- 名片墙：小程序裸启动（扫体验版二维码 / 直接打开）时的落地页。
     访客在这里先看到「这家公司有谁」，点某人进名片。
     各状态必须分开画，混在一起会让访客误以为系统坏了：
       redirecting（正按缓存的默认入口改道）/ loading / error（网络）/
       unavailable（企业不存在或停用）/ empty（公司还没人）/ 搜不到 -->
<!-- 启动遮罩：与名片页共用 app.wxss 的 .wc-boot，reLaunch 时两帧像素一致。
     booting 为决策态（还在判断去墙还是去名片页）；决策完成后 bootFade 让
     opacity 淡出，transitionend 再撤掉节点，避免「加载文字直接消失」的硬切。 -->
<view class="wc-boot wc-theme {{themeClass}} {{bootFade ? 'wc-boot-off' : ''}}" wx:if="{{bootVisible}}"
  bindtransitionend="onBootFadeEnd" catchtouchmove="noop">
  <view class="wc-boot-inner">
    <view class="wc-boot-title" wx:if="{{bootTitle}}">{{bootTitle}}</view>
    <view class="wc-boot-spinner"></view>
    <view class="wc-boot-text">正在打开…</view>
  </view>
</view>

<!-- 自定义导航：team.json 用 navigationStyle=custom，不再让微信按静态 json
     先画一帧「团队成员」。标题由 navTitle 单点控制：
     首屏与启动遮罩同源，取 app.json 的小程序名称；
     确认是名片墙后换企业简称，错误态给中性标题；改道中始终留白。 -->
<view class="team-custom-nav wc-theme {{themeClass}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="team-nav-inner">
    <!-- 返回：只有「从别的页面 navigateTo 进来」时才出现（见 team.ts 的 canBack）。
         裸启动 / 扫码 / 改道进来时页面栈里没有可返回的上一页，画一个点了没反应的
         返回箭头比不画更糟——访客会以为小程序坏了。 -->
    <view class="team-nav-back" wx:if="{{canBack}}" bindtap="goBack" hover-class="team-nav-back-hover">
      <view class="team-nav-back-arrow"></view>
      <text class="team-nav-back-text">返回</text>
    </view>
    <view class="team-nav-title" wx:if="{{!redirecting && navTitle}}">{{navTitle}}</view>
  </view>
</view>
<view class="team-nav-spacer" style="height: {{navHeight}}px;"></view>

<!-- 抬头：企业信息回来之前**整块不渲染**。
     原来这里不管有没有数据都画，而 title 的初始值是产品名「微传名片」——
     企业配了「默认进某位员工名片」时这一页只是中转站，弱网下要停 1~3 秒，
     访客看到的就是「微传名片 + 加载中」：自家小程序顶着平台名，像没配置好
     （2026-11-04 反馈）。title 为空时连 LOGO 也没有，整块收掉最干净。 -->
<view class="team-hero wc-theme {{themeClass}}" wx:if="{{!booting && !redirecting && (title || logo)}}">
  <!-- 企业 LOGO 挂了 binderror：LOGO 丢了就整块收掉（留白），
       否则页头正中会挂一块裂图，比没有 LOGO 更难看 -->
  <image class="team-logo" src="{{logo}}" mode="aspectFit" wx:if="{{logo && logoFail !== logo}}"
    binderror="onImgFail" data-fail="logoFail" data-src="{{logo}}" />
  <view class="team-name" wx:if="{{title}}">{{title}}</view>
  <view class="team-sub" wx:if="{{!loading && !error && !unavailable && total > 0}}">
    <block wx:if="{{activeKeyword}}">找到 {{total}} 位匹配的同事</block>
    <block wx:else>共 {{total}} 位同事，点击查看名片</block>
  </view>
</view>

<!-- 搜索框：只在企业可用**且已加载完**时出现。加载中给一个还搜不了的输入框，
     并不能帮上忙，反而诱使访客去点（2026-11-04）。
     输入不发请求，按「搜索」键才查——每敲一个字打一次接口既费流量，
     也会让宫格不停闪烁。 -->
<view class="team-search wc-theme {{themeClass}}" wx:if="{{!booting && !redirecting && !unavailable && !loading}}">
  <input
    class="team-search-input"
    value="{{keyword}}"
    placeholder="搜索姓名或职位"
    placeholder-class="team-search-ph"
    confirm-type="search"
    bindinput="onKeywordInput"
    bindconfirm="onSearch"
  />
  <view class="team-search-clear" wx:if="{{keyword}}" catchtap="onClearSearch">✕</view>
</view>

<!-- 页内重载提示：首帧已由上面的全屏遮罩接管，这里只服务「搜索 / 下拉刷新」
     这类页面已经在展示内容、但新一轮请求在途的场景。加 !booting 保证启动期
     绝不会再冒出第二句「加载中…」；决策完成后同一帧 loading 已落 false，
     所以正常进入也不会看到它闪一下。 -->
<view wx:if="{{!booting && !redirecting && loading}}" class="loading wc-theme {{themeClass}}">加载中…</view>

<view wx:elif="{{error}}" class="error-box wc-theme {{themeClass}}">
  <view class="error-text">网络异常，加载失败</view>
  <button class="retry-btn" bindtap="load">重新加载</button>
</view>

<view wx:elif="{{unavailable}}" class="error-box wc-theme {{themeClass}}">
  <view class="error-text">该企业暂不可用</view>
  <view class="team-hint">可能已停用或链接已失效，请向分享者确认后再试。</view>
  <button class="retry-btn" bindtap="load">重试</button>
</view>

<!-- 这里是 elif 而不是 else：改道中（redirecting）必须**什么都不画**，
     否则会在跳走前闪一下「还没有可展示的名片」。 -->
<view class="wc-theme {{themeClass}}" wx:elif="{{!redirecting}}">
  <!-- 宫格：三列，头像 + 姓名 + 职位 -->
  <view class="team-grid" wx:if="{{list.length}}">
    <view
      class="team-cell"
      wx:for="{{list}}"
      wx:key="staffId"
      data-id="{{item.staffId}}"
      bindtap="onTap"
    >
      <image class="team-avatar" src="{{item.avatarThumb}}" mode="aspectFill" wx:if="{{item.avatar}}"
        binderror="onImgErr" data-arr="list" data-idx="{{index}}" data-key="avatarThumb" data-full="{{item.avatar}}" />
      <view class="team-avatar team-avatar-ph" wx:else>{{item.name}}</view>
      <view class="team-cell-name">{{item.name}}</view>
      <view class="team-cell-title" wx:if="{{item.title}}">{{item.title}}</view>
    </view>
  </view>

  <!-- 搜不到：与「公司还没人」必须分开说，否则访客以为这家公司是空壳 -->
  <view class="team-empty" wx:elif="{{activeKeyword}}">
    <view class="team-empty-title">没有找到「{{activeKeyword}}」</view>
    <view class="team-hint">换个姓名或职位关键词试试。</view>
  </view>

  <!-- 公司还没人开通名片：说清「不是坏了，是还没人」 -->
  <view class="team-empty" wx:else>
    <view class="team-empty-title">该公司还没有可展示的名片</view>
    <view class="team-hint">员工开通名片后会出现在这里。</view>
  </view>

  <!-- 还有更多人：进「查看全部」做滚动加载。
       首屏只拉 60，500 人的企业不必等 300 条 JSON 解析完才出画面。 -->
  <view class="team-more" wx:if="{{hasMore}}" bindtap="goAll">
    <view class="team-more-btn">
      查看全部 {{total}} 位<block wx:if="{{activeKeyword}}">匹配的</block>同事
    </view>
  </view>
</view>
