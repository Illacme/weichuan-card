/* 申请目标企业行（多租户分发）：企业名加粗展示，让访客确认申请加入的企业 */
.company-value {
  flex: 1;
  color: #2f6bff;
  font-weight: 600;
}

/* 隐私政策同意行：自定义勾选框 + 告知文案。
   未勾选时提交按钮会拦住并提示（校验在 open.ts 的 onSubmit）。 */
.agree-row {
  display: flex;
  align-items: flex-start;
  margin: 20rpx 0 10rpx;
}
.agree-box {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #c3ccd6;
  border-radius: 6rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: #fff;
  box-sizing: border-box;
}
.agree-box-on {
  background: #2f6bff;
  border-color: #2f6bff;
}
.agree-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}
.agree-link {
  color: #2f6bff;
}
