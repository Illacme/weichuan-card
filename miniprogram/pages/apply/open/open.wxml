<view class="form" wx:if="{{!submitted}}">
  <!-- 申请目标企业（多租户分发）：企业独立版恒为锁定企业；平台模式按扫码/分享粘滞或后端缺省 -->
  <view class="form-item company-row" wx:if="{{companyName}}">
    <text class="label">申请加入</text>
    <text class="company-value">{{companyName}}</text>
  </view>
  <!-- 头像：默认读取微信头像，也支持上传 -->
  <view class="form-item avatar-row">
    <text class="label">头像</text>
    <image class="avatar-preview" src="{{form.avatar}}" mode="aspectFill" wx:if="{{form.avatar}}" />
    <view class="avatar-ph" wx:else>未设置</view>
    <button class="picker-btn" size="mini" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">微信头像</button>
    <button class="picker-btn" size="mini" bindtap="chooseImage">上传头像</button>
  </view>
  <!-- 微信昵称：用官方「头像昵称填写能力」的原生输入框（type="nickname"），
       聚焦时由微信调起真实昵称自动填充（与上方头像的 chooseAvatar 同一套能力）。
       旧做法是「授权获取」按钮调 wx.getUserProfile —— 该接口已于 2022-10-25
       被平台收回，此后一律返回占位值「微信用户」，永远拿不到真昵称，
       点了等于白点。这里改用原生输入框，昵称也变成可手填的普通字段。 -->
  <view class="form-item">
    <text class="label">微信昵称</text>
    <input
      data-field="nickname"
      type="nickname"
      value="{{form.nickname}}"
      bindinput="onInput"
      placeholder="选填，点此可填入微信昵称"
    />
  </view>
  <view class="form-item">
    <text class="label">姓名</text>
    <input data-field="name" value="{{form.name}}" bindinput="onInput" placeholder="必填" />
  </view>
  <view class="form-item">
    <text class="label">手机</text>
    <input data-field="phone" value="{{form.phone}}" bindinput="onInput" placeholder="必填，将作为登录账号" />
    <!-- 「+ 备用手机号」：默认只露一个手机号输入框（多数人只有一个号），
         需要第二个时点这里展开，避免一上来两栏空框让人以为都要填 -->
    <view class="add-sub" wx:if="{{!showPhone2}}" bindtap="togglePhone2">
      <text class="add-sub-plus">+</text>
      <text class="add-sub-text">备用手机号</text>
    </view>
  </view>
  <!-- 备用手机号（选填）：点上一行右侧「+」展开；右侧「×」收起并清空，
       防止「看不见但仍被提交」的暗数据。
       不设文字标签（用户 2026-10-20 要求）——留一个等宽空 label 占位，
       输入框才能与其它行左缘对齐；提示改走输入框内的 placeholder -->
  <view class="form-item form-item-sub" wx:if="{{showPhone2}}">
    <text class="label"></text>
    <input data-field="phone2" value="{{form.phone2}}" bindinput="onInput" placeholder="备用手机号" />
    <view class="del-sub" bindtap="togglePhone2"><text class="del-sub-x">×</text></view>
  </view>
  <view class="form-item">
    <text class="label">职位</text>
    <input data-field="title" value="{{form.title}}" bindinput="onInput" placeholder="选填" />
  </view>
  <view class="form-item">
    <text class="label">座机</text>
    <input data-field="landline" value="{{form.landline}}" bindinput="onInput" placeholder="选填，如 0316-8023950" />
  </view>
  <view class="form-item">
    <text class="label">邮箱</text>
    <input data-field="email" value="{{form.email}}" bindinput="onInput" placeholder="选填" />
  </view>

  <!-- 隐私政策明示同意（PIPL「告知—同意」）：本表单采集姓名/手机/邮箱/座机等个人信息，
       必须由用户主动勾选，未勾选不允许提交（校验在 onSubmit）。
       勾选框用自定义 view 而非原生 checkbox：原生控件在小程序里样式不可控，
       且要放进 checkbox-group 才能点文字也能勾。 -->
  <view class="agree-row" bindtap="toggleAgree">
    <view class="agree-box {{agreed ? 'agree-box-on' : ''}}">{{agreed ? '✓' : ''}}</view>
    <view class="agree-text">
      <text>我已阅读并同意</text>
      <text class="agree-link" catchtap="goPrivacy">《隐私政策》</text>
      <text>，同意本小程序收集上述信息用于生成与展示我的电子名片</text>
    </view>
  </view>

  <button class="submit-btn" loading="{{saving}}" bindtap="onSubmit">提交申请</button>
  <view class="tip">
    提交后由超管在 PC 后台审核，通过即自动创建账号；头像与微信昵称为选填，便于管理员核实身份，头像也可登录后在「编辑名片」中修改。手机号右侧的「+ 备用手机号」可展开第二个号码（选填）：填写后名片上与主号并列展示，主号仍作为登录账号
  </view>
</view>

<view class="done" wx:else>
  <view class="done-icon">✓</view>
  <view class="done-title">申请已提交</view>
  <view class="done-tip">超管审核通过后，请用提交的手机号作为账号、接收到的初始密码登录</view>
  <button class="primary-btn" bindtap="backMe">返回「我的」</button>
</view>

<!-- 微信隐私授权弹窗：调用隐私接口（选图 / 昵称）前由 ensurePrivacy 弹出，
     用户同意后才继续。组件挂在页面末尾，遮罩层覆盖全屏。 -->
<privacy-consent visible="{{privacyVisible}}" />
