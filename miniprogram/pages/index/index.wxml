<!-- 启动遮罩：与名片墙共用 app.wxss 的 .wc-boot。两页首帧逐字相同，
     reLaunch 清栈重建时视觉连续；数据回来后 bootFade 触发 opacity 淡出，
     transitionend 再撤节点，不再有「加载文字直接消失」的硬切。 -->
<view class="wc-boot wc-theme {{themeClass}} {{bootFade ? 'wc-boot-off' : ''}}" wx:if="{{bootVisible}}"
  bindtransitionend="onBootFadeEnd" catchtouchmove="noop">
  <view class="wc-boot-inner">
    <view class="wc-boot-title" wx:if="{{bootTitle}}">{{bootTitle}}</view>
    <view class="wc-boot-spinner"></view>
    <view class="wc-boot-text">正在打开…</view>
  </view>
</view>

<block wx:if="{{error}}">
  <view class="error-box wc-theme {{themeClass}}">
    <view class="error-text">网络异常，加载失败</view>
    <button class="retry-btn" bindtap="reload">重新加载</button>
  </view>
</block>

<block wx:elif="{{!loading}}">
  <!-- 顶部主色浓度由后台滑杆控制：topAlpha=浓度/100，fadeAlpha=topAlpha×0.9（单调递减）。
       bgGradientAlpha 缺省 1（原色），兼容旧缓存/未下发字段的后端。 -->
  <view class="page {{bgImage && bgFail !== bgImage ? 'has-bg' : ''}} wc-theme {{themeClass}}" style="--top-alpha: {{bgGradientAlpha}}; --fade-alpha: {{bgGradientFadeAlpha}};">
    <!-- 首页背景图（可选，后台「首页布局」设置）：全屏铺底 + 遮罩压暗，
         白色内容卡片浮于其上，形成高端名片的层次感。
         背景图挂了 binderror：它是纯装饰，图没了就整块收掉（连遮罩与 has-bg 一起），
         否则会在白卡片后面留一块刺眼的白/裂图。 -->
    <image wx:if="{{bgImage && bgFail !== bgImage}}" class="page-bg" src="{{bgImage}}" mode="aspectFill"
      binderror="onImgFail" data-fail="bgFail" data-src="{{bgImage}}" />
    <view wx:if="{{bgImage && bgFail !== bgImage}}" class="page-bg-mask" style="opacity: {{bgMaskAlpha}}" />

    <!-- 自定义顶栏（navigationStyle=custom）：按设计稿融入浅蓝渐变背景，无白色底与居中标题，
         仅保留左上角「我的」入口，固定常驻 -->
    <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
      <!-- 顶部滚动遮罩：随 scrollTop 渐显（见 onPageScroll），让顶栏悬浮于内容之上，
           初始透明融入浅蓝背景，滚过「我的」图标下沿时平滑浮现 -->
      <view class="nav-mask" style="opacity: {{navMask}}"></view>
      <view class="nav-inner">
        <view class="nav-me" bindtap="goMe">
          <view class="nav-me-avatar" wx:if="{{meAvatar && meAvatarFail !== meAvatar}}"><image src="{{meAvatar}}" mode="aspectFill"
            binderror="onImgFail" data-fail="meAvatarFail" data-src="{{meAvatar}}" /></view>
          <!-- 无头像时显示默认用户图标；文字固定「我的」——不显示姓名，避免与名片卡信息重复。
               头像加载失败也落到这个默认图标（比一个空圆或裂图好认）。 -->
          <view class="nav-me-user-icon" wx:else></view>
          <text class="nav-me-text">我的</text>
        </view>
        <!-- 右上角「团队」入口：后台配了「默认进指定员工」时，裸启动会直接落在这张名片上，
             没有它访客就永远看不到名片墙。skipEntryCache=1 让墙这一次不被默认入口再次改道。 -->
        <view class="nav-team" bindtap="goTeam">
          <view class="nav-team-icon"></view>
          <text class="nav-team-text">团队</text>
        </view>
        <!-- 企业简称居中展示（pointer-events:none 不挡「我的」/「团队」点击）。
             企业信息未就绪时**留白**而不是写死某个企业名——一套代码多租户，
             写死客户名等于给别的客户看别人家的公司名 -->
        <!-- 顶部深底时反白：滚动过 navHeight（白遮罩浮现）或浓度调低（底变浅）时都要切回深色，
             否则浅蓝底上的白字看不清（见 index.wxss） -->
        <!-- 有背景图时顶栏透明、图铺满顶部，浓度只影响已被盖住的主题渐变，
             不能再拿它把标题切成深色（玫瑰金这类浅图上的深字会看不清）。
             是否切深色只看滚动后的白遮罩 navMask。 -->
        <view class="nav-title {{navMask >= 0.5 || (!bgImage || bgFail === bgImage) && bgGradientStrength < 50 ? 'scrolled' : ''}}">{{company.shortName || company.fullName || ''}}</view>
      </view>
    </view>
    <view class="nav-spacer" style="height: {{navHeight}}px;" />

    <block wx:if="{{disabled}}">
      <view class="disabled-tip">该员工名片已停用</view>
    </block>
    <block wx:elif="{{notFound}}">
      <view class="disabled-tip">员工不存在，请检查编号</view>
    </block>
    <block wx:else>
      <!-- id 供自动化/调试寻址用：自定义组件内部元素跨组件选不到（>>> 也不支持），
           有 id 才能用 page.selectComponent('#emp-card') 直接拿到组件实例 -->
      <employee-card id="emp-card" class="mp-card-area" employee="{{employee}}" company="{{company}}" case-arrow="{{caseArrow}}" logo-size="{{logoSize}}" logo-align="{{logoAlign}}" bind:entercase="onEnterCase" />
      <view class="section mp-profile">
        <!-- 「公司简介」标题按设计稿叠在封面图左上角（见 company-video 组件），此处不再单列。
             视频来源由后端 videoSource 决定，组件内部自行选档 + 失败兜底 -->
        <company-video
          videoSource="{{profile.videoSource}}"
          feedId="{{profile.videoFeedId}}"
          feedToken="{{profile.videoFeedToken}}"
          channelId="{{profile.videoChannelId}}"
          playMode="{{profile.videoChannelPlayMode}}"
          vid="{{profile.videoVid}}"
          videoUrl="{{profile.videoUrl}}"
          backupUrl="{{profile.videoBackupUrl}}"
          fallback="{{profile.videoFallbackUrl}}"
          autoplay="{{profile.videoAutoplay}}"
          cover="{{profile.cover}}"
          staffId="{{staffId}}"
        />
        <!-- .pf-text 是纯版式分组容器：dom 上仍按「公司名 → 分隔线 → 简介」原顺序，
             不隐藏任何节点，只为让风格层能把它当成一整栏处理。没有它，.mp-profile 的
             四个子节点平级，就做不出「左图右文」（teal）与「左窄栏公司名 / 右通栏简介」
             （ink）这两种版式，四款风格只剩尺寸差异（用户 2026-11-12 批评的原话：
             「印刷的名片也有很多种布局样式啊，为什么你就没有更多灵活性的考虑呢」）。
             default 款不给 .pf-text 写任何规则，它就是普通块级容器，视觉零变化。 -->
        <!-- 首页「视频下方文字区」：公司名称与简介文字各有自己的四档展示档位
             （large/medium/small/hidden，后端 /api/card 已归一）。
             hidden 用 wx:if **移除节点**，不是 display:none——那一行连高度都不占，
             客户关掉后下面的板块立刻上移。两者可独立关闭，所以 .pf-text 上按
             剩余块加 pf-text--only-* 修饰：ink 的双栏 grid 在只剩一块时塌成单栏，
             否则空出来的 34% 列仍在挤占屏幕。 -->
        <view class="pf-text{{company.companyNameScale === 'hidden' ? ' pf-text--only-intro' : ''}}{{profile.introFontScale === 'hidden' ? ' pf-text--only-name' : ''}}">
          <block wx:if="{{company.companyNameScale !== 'hidden'}}">
            <view class="company-name company-name-size-{{company.companyNameScale || 'large'}}">{{company.fullName}}</view>
            <!-- 企业名下分隔线：左蓝右灰分段线，与名片卡横线（ec-rows-line）同款 -->
            <view class="line-split company-name-line"></view>
          </block>
          <!-- 只加修饰 class，不覆盖 .intro 本身——风格层的 line-height 覆盖照旧生效 -->
          <text wx:if="{{profile.introFontScale !== 'hidden'}}" class="intro intro-size-{{profile.introFontScale || 'large'}}">{{profile.introText}}</text>
        </view>
      </view>
      <block wx:for="{{homeOrder}}" wx:key="*this">
        <view wx:if="{{item === 'achievement'}}" id="sec-achievement" class="section mp-achievements">
          <view class="sec-head">
            <view class="sec-title">经典业绩</view>
            <!-- 「更多案例」：进入全部项目案例列表（列表页带业绩分类切换），
                 不再复用 onEnterCase——那个是滚动到本区块，在区块标题里等于滚到自己 -->
            <view class="sec-link" bindtap="goAllCases">更多案例 <text class="sec-arr">▸</text></view>
          </view>
          <!-- 板块标题装饰线：一小段左蓝右灰（用户 2026-10-20 要求，与企业名下同款语言） -->
          <view class="line-split sec-title-line"></view>
          <achievement-grid categories="{{categories}}" staffId="{{staffId}}" showName="{{showCategoryName}}" />
          <featured-projects featured="{{featured}}" featuredCount="{{featuredCount}}" effect="{{featuredEffect}}" staffId="{{staffId}}" />
        </view>
        <view wx:if="{{item === 'service'}}" class="section mp-services">
          <view class="sec-title">业务服务</view>
          <view class="line-split sec-title-line"></view>
          <service-grid services="{{services}}" staffId="{{staffId}}" showName="{{showServiceName}}" wx:if="{{services.length}}" />
          <view class="empty" wx:else>暂无服务内容</view>
        </view>
      </block>
      <!-- 底部留白只由 .page 的 padding-bottom 统一负责（含底栏避让 + 呼吸 + 安全区）。
           曾在这里额外写死 120rpx spacer，与 padding-bottom 叠加成大块空白
           （2026-11-18 用户截图实测），已移除，避免底栏挡内容只需那一处。 -->
      <action-bar employee="{{employee}}" company="{{company}}" staffId="{{staffId}}" />
    </block>
  </view>
</block>

<!-- 微信隐私授权弹窗：点「存入通讯录」时由 ensurePrivacy 弹出，同意后才调 addPhoneContact。
     放在最外层（不属于 loading / error / 正常态任一分支），保证任何状态下
     selectComponent('#privacy-consent') 都能找到——找不到时 ensurePrivacy 会放行，
     等于放弃自绘弹窗、退化成微信官方兜底，用户就又会撞上「需要隐私授权」那条死路。 -->
<privacy-consent id="privacy-consent" visible="{{privacyVisible}}" />
