<block wx:if="{{loading}}">
  <view class="loading">加载中…</view>
</block>

<block wx:elif="{{error}}">
  <view class="error-box">
    <view class="error-text">网络异常，加载失败</view>
    <button class="retry-btn" bindtap="reload">重新加载</button>
  </view>
</block>

<block wx:else>
  <view class="page {{bgImage && bgFail !== bgImage ? 'has-bg' : ''}}">
    <!-- 首页背景图（可选，后台「首页布局」设置）：全屏铺底 + 遮罩压暗，
         白色内容卡片浮于其上，形成高端名片的层次感。
         背景图挂了 binderror：它是纯装饰，图没了就整块收掉（连遮罩与 has-bg 一起），
         否则会在白卡片后面留一块刺眼的白/裂图。 -->
    <image wx:if="{{bgImage && bgFail !== bgImage}}" class="page-bg" src="{{bgImage}}" mode="aspectFill"
      binderror="onImgFail" data-fail="bgFail" data-src="{{bgImage}}" />
    <view wx:if="{{bgImage && bgFail !== bgImage}}" class="page-bg-mask" style="opacity: {{bgMaskAlpha}}" />

    <!-- 自定义顶栏（navigationStyle=custom）：按设计稿融入浅蓝渐变背景，无白色底与居中标题，
         仅保留左上角「我的」入口，固定常驻 -->
    <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
      <!-- 顶部滚动遮罩：随 scrollTop 渐显（见 onPageScroll），让顶栏悬浮于内容之上，
           初始透明融入浅蓝背景，滚过「我的」图标下沿时平滑浮现 -->
      <view class="nav-mask" style="opacity: {{navMask}}"></view>
      <view class="nav-inner">
        <view class="nav-me" bindtap="goMe">
          <view class="nav-me-avatar" wx:if="{{meAvatar && meAvatarFail !== meAvatar}}"><image src="{{meAvatar}}" mode="aspectFill"
            binderror="onImgFail" data-fail="meAvatarFail" data-src="{{meAvatar}}" /></view>
          <!-- 无头像时显示默认用户图标；文字固定「我的」——不显示姓名，避免与名片卡信息重复。
               头像加载失败也落到这个默认图标（比一个空圆或裂图好认）。 -->
          <view class="nav-me-user-icon" wx:else></view>
          <text class="nav-me-text">我的</text>
        </view>
        <!-- 企业简称居中展示（pointer-events:none 不挡「我的」点击）。
             企业信息未就绪时**留白**而不是写死某个企业名——一套代码多租户，
             写死客户名等于给别的客户看别人家的公司名 -->
        <view class="nav-title">{{company.shortName || company.fullName || ''}}</view>
      </view>
    </view>
    <view class="nav-spacer" style="height: {{navHeight}}px;" />

    <block wx:if="{{disabled}}">
      <view class="disabled-tip">该员工名片已停用</view>
    </block>
    <block wx:elif="{{notFound}}">
      <view class="disabled-tip">员工不存在，请检查编号</view>
    </block>
    <block wx:else>
      <!-- id 供自动化/调试寻址用：自定义组件内部元素跨组件选不到（>>> 也不支持），
           有 id 才能用 page.selectComponent('#emp-card') 直接拿到组件实例 -->
      <employee-card id="emp-card" employee="{{employee}}" company="{{company}}" case-arrow="{{caseArrow}}" bind:entercase="onEnterCase" />
      <view class="section">
        <!-- 「公司简介」标题按设计稿叠在封面图左上角（见 company-video 组件），此处不再单列。
             视频来源由后端 videoSource 决定，组件内部自行选档 + 失败兜底 -->
        <company-video
          videoSource="{{profile.videoSource}}"
          feedId="{{profile.videoFeedId}}"
          feedToken="{{profile.videoFeedToken}}"
          vid="{{profile.videoVid}}"
          videoUrl="{{profile.videoUrl}}"
          fallback="{{profile.videoFallbackUrl}}"
          cover="{{profile.cover}}"
          staffId="{{staffId}}"
        />
        <view class="company-name">{{company.fullName}}</view>
        <!-- 企业名下分隔线：左蓝右灰分段线，与名片卡横线（ec-rows-line）同款 -->
        <view class="line-split company-name-line"></view>
        <text class="intro">{{profile.introText}}</text>
      </view>
      <block wx:for="{{homeOrder}}" wx:key="*this">
        <view wx:if="{{item === 'achievement'}}" id="sec-achievement" class="section">
          <view class="sec-head">
            <view class="sec-title">经典业绩</view>
            <!-- 「更多案例」：进入全部项目案例列表（列表页带业绩分类切换），
                 不再复用 onEnterCase——那个是滚动到本区块，在区块标题里等于滚到自己 -->
            <view class="sec-link" bindtap="goAllCases">更多案例 <text class="sec-arr">▸</text></view>
          </view>
          <!-- 板块标题装饰线：一小段左蓝右灰（用户 2026-10-20 要求，与企业名下同款语言） -->
          <view class="line-split sec-title-line"></view>
          <achievement-grid categories="{{categories}}" staffId="{{staffId}}" />
          <featured-projects featured="{{featured}}" staffId="{{staffId}}" />
        </view>
        <view wx:if="{{item === 'service'}}" class="section">
          <view class="sec-title">业务服务</view>
          <view class="line-split sec-title-line"></view>
          <service-grid services="{{services}}" staffId="{{staffId}}" wx:if="{{services.length}}" />
          <view class="empty" wx:else>暂无服务内容</view>
        </view>
      </block>
      <view style="height: 120rpx;" />
      <action-bar employee="{{employee}}" company="{{company}}" staffId="{{staffId}}" />
    </block>
  </view>
</block>

<!-- 微信隐私授权弹窗：点「存入通讯录」时由 ensurePrivacy 弹出，同意后才调 addPhoneContact。
     放在最外层（不属于 loading / error / 正常态任一分支），保证任何状态下
     selectComponent('#privacy-consent') 都能找到——找不到时 ensurePrivacy 会放行，
     等于放弃自绘弹窗、退化成微信官方兜底，用户就又会撞上「需要隐私授权」那条死路。 -->
<privacy-consent id="privacy-consent" visible="{{privacyVisible}}" />
