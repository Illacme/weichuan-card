/* 首页自定义顶栏（navigationStyle=custom）：按设计稿融入浅蓝渐变背景——
   无白色底、无边框线、无居中标题，仅左上角「我的」入口，固定常驻 */
.custom-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: transparent;
}
.custom-nav .nav-inner {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
  z-index: 1;
}
/* 顶部滚动遮罩：随 scrollTop 渐显（opacity 绑定 navMask）。
   顶部近白、向下渐隐到透明，让顶栏「悬浮」于内容之上；底部极淡阴影制造层次。
   初始 opacity 0（顶栏透明融入背景），滚动后平滑浮现。 */
.custom-nav .nav-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: calc(100% + 80rpx);
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(247,251,255,0.92) 48%, rgba(247,251,255,0) 100%);
  box-shadow: 0 8rpx 24rpx rgba(30,90,160,0.05);
  transition: opacity .25s ease-out;
}
.custom-nav .nav-me {
  display: flex;
  align-items: center;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(var(--wc-primary-rgb), 0.45);
  border-radius: 28rpx;
}
.custom-nav .nav-me-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 10rpx;
  background: #eee;
}
.custom-nav .nav-me-avatar image {
  width: 100%;
  height: 100%;
}
.custom-nav .nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  pointer-events: none;
}
.custom-nav .nav-me-user-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: url("data:image/png;base64,") no-repeat center / 100% 100%;
}
/* 图标单独出现（未登录无姓名）时去掉右侧留白 */
.custom-nav .nav-me-user-icon:last-child { margin-right: 0; }
.custom-nav .nav-me-text {
  font-size: 26rpx;
  color: var(--wc-primary);
}

/* 首页背景：无后台背景图时跟随风格模板的浅色调（与后台预览图一致，
   切模板背景随之变色）；有「首页背景」图时由 page-bg（fixed + 负 z-index）
   整幅覆盖，主题渐变自然被盖住。两者都是主题 token，未设背景图即生效。 */
.page {
  position: relative;
  min-height: 100vh;
  /* 底部避让：action-bar 为 fixed bottom（见 app.wxss .action-bar），滚到底时
     最后一个 section 会被它盖住。实测其总高≈177rpx（按钮75 + padding32 + 安全区~70），
     固定部分（按钮+padding）≈107rpx 写死，安全区用 env() 随设备；+16rpx 呼吸感，
     既不被遮挡也不留大片空白（用户 2026-10-20 反馈 260rpx 留太多） */
  padding-bottom: calc(123rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, var(--wc-primary-soft), var(--wc-primary-tint));
}
.page-bg { position: fixed; left: 0; right: 0; top: 0; bottom: 0; width: 100%; height: 100%; z-index: -1; }
.page-bg-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: #000; z-index: -1; }

/* 内容板块（设计稿：白色圆角卡片浮于浅蓝背景，仅作用于首页，不影响「我的」页）。
   两侧边距与 .emp-card 对齐收紧（20rpx 外距 + 24rpx 内距）：
   用户要求「内容区两边距减少一点，多腾出名片内容空间」，全线统一避免卡片左右错位。 */
.page .section {
  background: #fff;
  border-radius: var(--wc-r-card);
  margin: 20rpx 20rpx 0;
  padding: 24rpx;
  box-shadow: var(--wc-card-shadow-soft);
  box-sizing: border-box;
}
/* 板块标题统一与下方装饰线紧贴：间距只由 .sec-title-line 的 margin-top 控制，
   标题自身 margin-bottom 置 0（否则与线的 margin-top 叠加，线离标题偏远——
   用户 2026-10-20 反馈「横线距离太远」） */
.page .section .sec-title { margin-bottom: 0; }

/* 「经典业绩」标题行：左侧标题 + 右侧「更多案例」小字链接（进入全部项目案例列表页） */
.sec-head { display: flex; align-items: center; justify-content: space-between; }
.sec-head .sec-title { margin-bottom: 0; }
.sec-link { font-size: 24rpx; color: #8aa5c0; }
/* 更多案例右侧箭头：与名片卡「查看案例▸」用同一套实心小三角，改掉原来较粗的 → 字符；
   font-weight 略加让三角更清晰，左距给文字一点呼吸（用户 2026-10-20 反馈箭头需换） */
.sec-arr { margin-left: 4rpx; font-weight: 700; }

/* 简介区：视频封面下的公司名大标题（设计稿黑色加粗） */
.company-name { font-size: 34rpx; font-weight: 700; color: #222; margin-top: 24rpx; }

/* 有背景时的高端包装：卡片半透明浮起 + 圆角阴影，与深色背景形成层次 */
.has-bg .custom-nav { background: rgba(255,255,255,.94); }
.has-bg .section { background: rgba(255,255,255,.95); border-radius: var(--wc-r-card-bg); margin: 20rpx 24rpx; padding: 28rpx; box-shadow: var(--wc-card-shadow-bg); }
.has-bg .nav-spacer + .section, .has-bg .section:first-of-type { margin-top: 20rpx; }

/* 左蓝右灰分段线（2026-10-20 用户要求：与名片卡 ec-rows-line 同款视觉语言）。
   border 只能单色，所以用独立 view + linear-gradient 硬切：左 34% 品牌蓝、右 66% 浅灰。
   企业名下那条为通栏；板块标题（经典业绩/业务服务）下为短装饰线。 */
.line-split {
  height: 2rpx;
  background: linear-gradient(90deg, var(--wc-primary-deep) 0, var(--wc-primary-deep) 34%, var(--wc-track) 34%, var(--wc-track) 100%);
}
/* 企业名下：通栏，紧贴名称（间距由 .company-name 的 padding-bottom 提供） */
.company-name-line { margin: 0; }
/* 板块标题下：一小段，左对齐卡片内容左缘；上间距 6rpx 紧贴标题（文字行高 leading
   之外仅 3px），下间距 20rpx 与内容区分隔 */
.sec-title-line { width: 220rpx; margin: 6rpx 0 20rpx; }
