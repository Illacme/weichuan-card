<view class="me">
  <!-- 未登录：登录 / 申请开通 两个入口（B9：员工「我的」页含登录与申请开通表单） -->
  <view class="section guest" wx:if="{{!me}}">
    <view class="guest-tip">登录后可管理自己的名片、查看访客数据</view>
    <button class="primary-btn" bindtap="goLogin">员工登录</button>
    <button class="plain-btn" bindtap="goApply">申请开通员工账号</button>
    <view class="guest-hint">暂无账号？提交开通申请，超管审核通过后即可登录</view>
    <!-- 隐私政策入口：未登录访客也要能查阅（微信审核要求应用内可查阅隐私指引） -->
    <view class="cell" bindtap="goPrivacy" hover-class="cell-hover">
      <text class="cell-label muted">隐私政策</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 已登录 -->
  <block wx:else>
    <view class="section profile">
      <image class="avatar" src="{{me.avatar}}" mode="aspectFill" wx:if="{{me.avatar}}" />
      <view class="avatar" wx:else />
      <view class="pinfo">
        <view class="pname">{{me.name}}</view>
        <view class="ptitle">{{me.title || '未填写职位'}} · 编号 {{me.staffId}}</view>
      </view>
    </view>

    <!-- 名片：看 / 改 / 分享。看与改是同一张名片，故相邻；分享紧随其后 -->
    <view class="section cells">
      <view class="cell" bindtap="goMyCard" hover-class="cell-hover">
        <text class="cell-label">我的名片</text>
        <text class="cell-arrow">›</text>
      </view>
      <view class="cell" bindtap="goEdit" hover-class="cell-hover">
        <text class="cell-label">编辑名片</text>
        <text class="cell-value">{{pendingModify ? '审核中' : '修改需超管审核'}}</text>
        <text class="cell-arrow">›</text>
      </view>
      <view class="cell" bindtap="goPoster" hover-class="cell-hover">
        <text class="cell-label">生成海报</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 数据：对外访客/转化分析（与下方「个人信息」是两个东西，靠分组与命名区分） -->
    <view class="group-label">数据</view>
    <view class="section cells">
      <view class="cell" bindtap="goStat" hover-class="cell-hover">
        <text class="cell-label">数据统计</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 账号安全 -->
    <view class="group-label">账号</view>
    <view class="section cells">
      <view class="cell" bindtap="openPwd" hover-class="cell-hover">
        <text class="cell-label">修改密码</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 退出登录：独立按钮，与下方红色「注销账号」拉开，避免同级红色误触 -->
    <view class="logout-wrap">
      <button class="logout-btn" bindtap="onLogoutTap">退出登录</button>
    </view>

    <!-- 隐私与合规：隐私政策 / 个人信息（查阅复制，PIPL）/ 注销账号（删除权，不可恢复） -->
    <view class="group-label">隐私与合规</view>
    <view class="section cells">
      <view class="cell" bindtap="goPrivacy" hover-class="cell-hover">
        <text class="cell-label muted">隐私政策</text>
        <text class="cell-arrow">›</text>
      </view>
      <!-- 原「我的数据」：查阅 / 复制本人个人信息（PIPL 查阅复制权），名字易与「数据统计」混淆故改名 -->
      <view class="cell" bindtap="goMydata" hover-class="cell-hover">
        <text class="cell-label">个人信息</text>
        <text class="cell-value">查阅 / 复制</text>
        <text class="cell-arrow">›</text>
      </view>
      <!-- 注销账号：PIPL 删除权。不可恢复，故走二次强确认（见 me.ts cancelAccount） -->
      <view class="cell" bindtap="cancelAccount" hover-class="cell-hover">
        <text class="cell-label danger">注销账号</text>
        <text class="cell-value">不可恢复</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- 修改密码弹窗 -->
  <view class="mask" wx:if="{{pwdVisible}}" bindtap="closePwd"></view>
  <view class="pwd-dialog" wx:if="{{pwdVisible}}">
    <view class="pwd-title">修改密码</view>
    <view class="form-item">
      <text class="label">原密码</text>
      <input data-field="oldPwd" value="{{pwd.oldPwd}}" bindinput="onPwdInput" password placeholder="请输入原密码" />
    </view>
    <view class="form-item">
      <text class="label">新密码</text>
      <input data-field="newPwd" value="{{pwd.newPwd}}" bindinput="onPwdInput" password placeholder="至少 6 位" />
    </view>
    <view class="form-item">
      <text class="label">确认新密码</text>
      <input data-field="confirmPwd" value="{{pwd.confirmPwd}}" bindinput="onPwdInput" password placeholder="再输一次" />
    </view>
    <view class="pwd-actions">
      <button class="plain-btn" bindtap="closePwd">取消</button>
      <button class="primary-btn" loading="{{pwdSaving}}" bindtap="submitPwd">确定</button>
    </view>
  </view>
</view>
