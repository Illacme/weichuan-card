<view class="form" wx:if="{{!loading}}">
  <!-- 审核中标签（需求 B9）：有待审修改申请时展示；审核期对外仍显示旧信息 -->
  <view class="pending-tip" wx:if="{{pendingModify}}">
    <text class="pending-tag">审核中</text>
    <text class="pending-text">修改已提交，等待超管审核，通过后生效</text>
  </view>
  <view class="form-item avatar-row">
    <text class="label">头像</text>
    <!-- 预览图挂了 binderror：这是表单字段，图挂了要说清「没传」还是「加载不出来」，
         都显示「未设置」会让用户以为刚才选图白选了 -->
    <image class="avatar-preview" src="{{form.avatar}}" mode="aspectFill" lazy-load wx:if="{{form.avatar && avatarFail !== form.avatar}}"
      binderror="onImgFail" data-fail="avatarFail" data-src="{{form.avatar}}" />
    <view class="avatar-ph" wx:else>{{form.avatar ? '加载失败' : '未设置'}}</view>
    <button class="picker-btn" size="mini" bindtap="chooseAvatar">选择图片</button>
  </view>
  <view class="form-item">
    <text class="label">姓名</text>
    <input data-field="name" value="{{form.name}}" bindinput="onInput" />
  </view>
  <view class="form-item">
    <text class="label">职位</text>
    <input data-field="title" value="{{form.title}}" bindinput="onInput" />
  </view>
  <view class="form-item">
    <text class="label">手机</text>
    <input data-field="phone" value="{{form.phone}}" bindinput="onInput" />
    <!-- 与申请开通页同一套交互：默认一个手机号，点右侧「+」展开备用号 -->
    <view class="add-sub" wx:if="{{!showPhone2}}" bindtap="togglePhone2">
      <text class="add-sub-plus">+</text>
      <text class="add-sub-text">备用手机号</text>
    </view>
  </view>
  <!-- 备用手机号（选填）：回填时若已有值则自动展开（见 loadMe）；「×」收起并清空。
       与申请开通页一致：不设文字标签，留等宽空 label 占位保持输入框左缘对齐，
       提示走输入框内的 placeholder -->
  <view class="form-item form-item-sub" wx:if="{{showPhone2}}">
    <text class="label"></text>
    <input data-field="phone2" value="{{form.phone2}}" bindinput="onInput" placeholder="备用手机号" />
    <view class="del-sub" bindtap="togglePhone2"><text class="del-sub-x">×</text></view>
  </view>
  <view class="form-item">
    <text class="label">座机</text>
    <input data-field="landline" value="{{form.landline}}" bindinput="onInput" placeholder="选填，如 021-88888888" />
  </view>
  <view class="form-item">
    <text class="label">邮箱</text>
    <input data-field="email" value="{{form.email}}" bindinput="onInput" />
  </view>
  <button class="submit-btn" bindtap="onSubmit">提交修改（待审）</button>
</view>
<view wx:else class="loading">加载中…</view>

<!-- 微信隐私授权弹窗：选图前由 ensurePrivacy 弹出，用户同意后才继续 -->
<privacy-consent id="privacy-consent" visible="{{privacyVisible}}" />
