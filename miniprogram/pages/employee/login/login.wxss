/* 登录页布局：整页浅冷灰底 + 顶部大面积浅蓝渐变（品牌区从渐变里浮出来），
   内容居中并限制最大宽度，平板/大屏不被拉散。
   顺序按产品逻辑：默认登录（手机号密码）在上，微信一键登录在下。
   此前整页白底、内容堆顶、无品牌识别、微信图标是纯 CSS 两个绿点，既空又散。 */
.login {
  min-height: 100vh;
  background: #f3f6fa;
  box-sizing: border-box;
  position: relative;
}
/* 顶部渐变：近顶浅蓝、向下淡出到灰底，给品牌区一片「天光」，也压住上方的空 */
.login::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 560rpx;
  background: linear-gradient(180deg, #dbe9ff 0%, #edf4ff 42%, rgba(243, 246, 250, 0) 100%);
  z-index: 0;
}
.login-inner {
  position: relative;
  z-index: 1;
  max-width: 680rpx;
  margin: 0 auto;
  padding: 0 44rpx 80rpx;
  box-sizing: border-box;
}

/* ---------- 品牌区 ---------- */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 110rpx 0 52rpx;
}
.brand-logo {
  width: 148rpx;
  height: 148rpx;
  border-radius: 36rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
/* 企业 LOGO 存在：白底细边，让各家透明/白底 LOGO 都好看 */
.brand-logo.has-img {
  background: #fff;
  border: 1rpx solid #eef2f7;
  box-shadow: 0 10rpx 26rpx rgba(30, 90, 160, 0.14);
}
.brand-logo-img { width: 100%; height: 100%; }
/* 没有 LOGO：蓝渐变磁贴 + 白色名片 glyph */
.brand-logo.is-glyph {
  background: linear-gradient(135deg, #1a8cff, #35b3ff);
  box-shadow: 0 16rpx 36rpx rgba(26, 140, 255, 0.30);
}
.brand-glyph {
  width: 76rpx;
  height: 76rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
/* 企业简称：登录页的主标题。全称兜底时可能较长，最多两行、超出省略 */
.brand-name {
  margin-top: 30rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: #18222f;
  letter-spacing: 1rpx;
  line-height: 1.25;
  text-align: center;
  max-width: 100%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.brand-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8494a6;
  letter-spacing: 3rpx;
}

/* ---------- 默认登录卡片（手机号密码，主入口） ---------- */
/* 用 .login .login-form（两级）压过全局 .form 的 padding，不依赖样式加载顺序 */
.login .login-form {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(30, 90, 160, 0.10);
  padding: 12rpx 32rpx 32rpx;
}
/* 两个输入框之间一条淡分隔线；密码框下方不画线，避免和按钮之间多一道 */
.login-form .form-item { padding: 30rpx 0; border-bottom: none; }
.login-form .form-item + .form-item { border-top: 1rpx solid #eef1f5; }
.login-form .submit-btn {
  margin: 36rpx 0 8rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #1a8cff, #35b3ff);
  box-shadow: 0 10rpx 24rpx rgba(26, 140, 255, 0.28);
}
.login-form .submit-btn::after { border: none; }

/* ---------- 「或」分隔线 ---------- */
.or-line { display: flex; align-items: center; margin: 40rpx 0 32rpx; }
.or-rule { flex: 1; height: 1rpx; background: #dfe5ec; }
.or-text { padding: 0 24rpx; font-size: 24rpx; color: #9aa7b4; }

/* ---------- 微信一键登录（次入口，在默认登录下方） ---------- */
/* 白底绿描边：弱于蓝色主按钮，形成「主 / 次」层级；但保留微信绿与微信 logo，
   仍一眼可辨是微信授权登录，不是小程序自造的账号体系。 */
.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  line-height: 1;
  background: #fff;
  border: 2rpx solid #c9ecd8;
  border-radius: 46rpx;
  box-shadow: 0 6rpx 18rpx rgba(7, 193, 96, 0.10);
}
.wx-login-btn::after { border: none; } /* 去掉 button 默认边框（button 唯一可用的重置手段） */
/* 微信气泡图标：内联 SVG（绿色微信 logo），不引入图片资源（包体越小冷启动越快） */
.wx-login-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.wx-login-label { font-size: 32rpx; font-weight: 600; color: #07c160; }

.wx-login-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa7b4;
  line-height: 1.6;
}
