<view class="login">
  <view class="login-inner">
    <!-- 品牌区：优先企业简称（有企业 LOGO 就显示 LOGO，否则渐变磁贴）。
         登录页顶着平台产品名会让客户觉得「没改干净」，所以这里只认企业名，
         拿不到企业名时显示中性的「员工登录」，不回落到产品名。 -->
    <view class="brand">
      <view class="brand-logo {{logo && logoFail !== logo ? 'has-img' : 'is-glyph'}}">
        <!-- 企业 LOGO 挂了 binderror：失败就回落到渐变磁贴，不挂一块裂图 -->
        <image
          wx:if="{{logo && logoFail !== logo}}"
          class="brand-logo-img"
          src="{{logo}}"
          mode="aspectFit"
          binderror="onImgFail"
          data-fail="logoFail"
          data-src="{{logo}}"
        />
        <view wx:else class="brand-glyph"></view>
      </view>
      <view class="brand-name">{{brand || '员工登录'}}</view>
      <view class="brand-sub" wx:if="{{brand}}">员工登录</view>
    </view>

    <!-- 默认登录：手机号 + 密码（主入口，收进白底圆角卡片） -->
    <view class="form login-form">
      <view class="form-item">
        <text class="label">手机号</text>
        <input data-field="phone" value="{{phone}}" bindinput="onInput" placeholder="请输入手机号" />
      </view>
      <view class="form-item">
        <text class="label">密码</text>
        <input data-field="password" value="{{password}}" bindinput="onInput" password placeholder="请输入密码" />
      </view>
      <button class="submit-btn" loading="{{submitting}}" bindtap="onSubmit">登录</button>
    </view>

    <view class="or-line">
      <view class="or-rule"></view>
      <text class="or-text">或</text>
      <view class="or-rule"></view>
    </view>

    <!-- 微信一键登录：放在默认登录按钮下方，作为次入口。
         白底绿描边弱于主按钮，但保留微信绿与微信 logo，仍一眼可辨。 -->
    <button class="wx-login-btn" loading="{{wxSubmitting}}" bindtap="onWechatLogin">
      <view class="wx-login-icon"></view>
      <text class="wx-login-label">微信一键登录</text>
    </button>
    <view class="wx-login-hint">首次使用请先用手机号密码登录，在「我的」页绑定微信后即可一键登录</view>
  </view>
</view>
