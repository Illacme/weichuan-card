<view class="login">
  <!-- 微信一键登录：主入口，放最上面并做成主按钮。
       员工忘记密码是 B 端最高频的工单，而「一键登录」把它整个省掉——
       前提是账号已绑定微信（自助申请开通的员工开箱即绑，后台建号的员工要绑一次）。 -->
  <button class="wx-login-btn" loading="{{wxSubmitting}}" bindtap="onWechatLogin">
    <view class="wx-login-icon">
      <view class="wx-login-dot"></view>
      <view class="wx-login-dot"></view>
    </view>
    <text class="wx-login-label">微信一键登录</text>
  </button>
  <view class="wx-login-hint">首次使用请先用手机号密码登录，登录后在「我的」页绑定微信</view>

  <view class="or-line">
    <view class="or-rule"></view>
    <text class="or-text">或使用手机号密码登录</text>
    <view class="or-rule"></view>
  </view>

  <view class="form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input data-field="phone" value="{{phone}}" bindinput="onInput" placeholder="请输入手机号" />
    </view>
    <view class="form-item">
      <text class="label">密码</text>
      <input data-field="password" value="{{password}}" bindinput="onInput" password placeholder="请输入密码" />
    </view>
    <button class="submit-btn" loading="{{submitting}}" bindtap="onSubmit">登录</button>
  </view>
</view>
