/* 管理员登录页：类名统一带 admlogin- 前缀，避免与全局样式撞名
   （新增全局类要跑 frontend/scripts/audit_class_collision.py，这里全部页面级）。 */
.admlogin {
  padding: 32rpx 0 48rpx;
}

.admlogin-hd {
  padding: 24rpx 32rpx 8rpx;
}

.admlogin-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.admlogin-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* 两个主按钮必须撑满内容区并居中、单行不折。
   app.wxss 的 .primary-btn/.plain-btn 只给了配色和圆角，没给宽度/行高；
   基础库 style v2 下 button 默认按内容收缩 + 左对齐，真机上就是「半屏宽、
   贴左边」，且「用当前微信免密进入」10 个字被挤成两行（2026-11-07 反馈）。
   750rpx 恒等于屏宽，686rpx = 屏宽 - 左右各 32rpx，比 calc() 兼容性更稳。 */
.admlogin .primary-btn,
.admlogin .plain-btn {
  display: block;
  box-sizing: border-box;
  width: 686rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  margin: 24rpx 32rpx 0;
  font-size: 30rpx;
  text-align: center;
  white-space: nowrap;
}

.admlogin-tip {
  margin: 28rpx 32rpx 0;
  font-size: 24rpx;
  color: #b2b2b2;
  line-height: 1.6;
}
