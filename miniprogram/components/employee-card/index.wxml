<view class="emp-card">
  <!-- 上半部：头像 + 姓名/职位 + 右上角企业 LOGO + 公司全称/查看案例 + 地址
       类名一律 ec- 前缀：组件 addGlobalClass 会吃到全局样式，
       通用名（cell/row/label…）会与「我的」页等全局类冲突泄漏样式 -->
  <view class="ec-head">
    <image class="ec-avatar" src="{{employee.avatar}}" mode="aspectFill" lazy-load wx:if="{{employee.avatar}}" />
    <view class="ec-avatar" wx:else />
    <view class="ec-info">
      <view class="ec-line1">
        <view class="ec-name">{{employee.name}}</view>
        <image class="ec-logo" src="{{company.logo}}" mode="aspectFit" lazy-load wx:if="{{company.logo}}" />
      </view>
      <view class="ec-title" wx:if="{{employee.title}}">{{employee.title}}</view>
      <view class="ec-line3">
        <view class="ec-cname">{{company.fullName}}</view>
        <!-- 细描边小药丸（两轮收紧：18rpx 字 + 固定高 28rpx + 左右 10rpx 内边距，
             行宽优先给公司名；箭头为黑色实心小三角 ▾/▸）。跳转行为由页面通过
             enter case 事件决定，箭头方向见 pages/index/index.ts -->
        <view class="case-btn" bindtap="onEnterCase">查看案例<text class="case-arrow">{{caseArrow}}</text></view>
      </view>
      <view class="ec-addr" wx:if="{{company.address}}">{{company.address}}</view>
    </view>
  </view>

  <!-- 下半部：联系表（2026-10-20 按用户反馈改版，三点变化）
       ① 第二个手机号与第一行「手机」的号码左对齐（第二行留一个与 ec-label 等宽的
          空标签占位即可对齐），不再显示「手机2」标签；没有副号时整行不渲染
       ② 座机/邮箱按邮箱长短自适应两档（class 由 index.ts 按邮箱文字像素宽判定）：
          短邮箱 → 左右各 50%；长邮箱 → 左列让到 40%，右列收缩到内容宽（上限 60%）
          并贴右，于是两行左缘对齐（座机与邮箱左对齐）且邮箱地址右缘贴内容右缘
       ③ 手机/座机/邮箱均可点击复制（onCopy → wx.setClipboardData），
          名片是转发给客户看的，客户最高频动作就是存号/发邮件 -->
  <view class="ec-rows">
    <view class="ec-rows-line" />
    <view class="ec-contact {{emailLong ? 'ec-contact-long' : 'ec-contact-short'}}">
      <view class="ec-col">
        <view class="ec-line">
          <text class="ec-label">手机</text>
          <view class="ec-val ec-tap" hover-class="ec-tap-hover" bindtap="onCopy" data-type="手机号" data-copy="{{employee.phone}}">{{employee.phone}}</view>
        </view>
        <view class="ec-line" wx:if="{{employee.phone2}}">
          <text class="ec-label"></text>
          <view class="ec-val ec-tap" hover-class="ec-tap-hover" bindtap="onCopy" data-type="副手机号" data-copy="{{employee.phone2}}">{{employee.phone2}}</view>
        </view>
      </view>
      <view class="ec-col ec-col-r">
        <view class="ec-line">
          <text class="ec-label">座机</text>
          <view class="ec-val ec-tap" hover-class="ec-tap-hover" bindtap="onCopy" data-type="座机号" data-copy="{{employee.landline || company.tel}}">{{employee.landline || company.tel}}</view>
        </view>
        <view class="ec-line ec-line-email">
          <text class="ec-label">邮箱</text>
          <view class="ec-val ec-val-email ec-tap" hover-class="ec-tap-hover" bindtap="onCopy" data-type="邮箱" data-copy="{{employee.email}}">{{employee.email}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
