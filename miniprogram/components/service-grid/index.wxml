<view class="svc-grid">
  <view class="svc-item" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="onTap">
    <!-- 有图：整卡按原比例展示（设计稿竖版卡片，标题已绘制在图内，不重复渲染文字标题） -->
    <image class="svc-icon" src="{{item.iconThumb}}" mode="widthFix" lazy-load wx:if="{{item.icon}}"
      binderror="onImgErr" data-arr="services" data-idx="{{index}}" data-key="iconThumb" data-full="{{item.icon}}" />
    <block wx:else>
      <view class="svc-icon-ph">{{item.title ? item.title.slice(0,1) : '服'}}</view>
      <view class="svc-title">{{item.title}}</view>
    </block>
  </view>
</view>
