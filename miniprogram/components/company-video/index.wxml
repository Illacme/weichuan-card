<view class="company-video">
  <!-- 同主体：feed-id（视频号助手 → 动态管理复制），可自动播放 -->
  <channel-video
    wx:if="{{mode === 'channels'}}"
    feed-id="{{feedId}}"
    object-fit="cover"
    class="cv-video"
    bind:error="onVideoError"
  />

  <!-- 跨主体：feed-id 官方明确仅同主体生效，不同主体必须改用 feed-token。
       代价是强制 autoplay=false（只能显示封面让用户点），故排在同主体之后。 -->
  <channel-video
    wx:elif="{{mode === 'channels-token'}}"
    feed-token="{{feedToken}}"
    object-fit="cover"
    class="cv-video"
    bind:error="onVideoError"
  />

  <!-- 腾讯视频插件：vid 取片，原位播放，画面不带视频号角标。
       playerid 需全局唯一（插件用它取 TxvContext 手动控制播放）；use-poster 让加载期
       显示腾讯视频按 vid 取到的默认海报，避免一块黑底。
       bindplay 接播放埋点：插件透传了 video 的完整事件，这是视频号档给不了的。 -->
  <txv-video
    wx:elif="{{mode === 'txv'}}"
    vid="{{vid}}"
    playerid="companyVideo"
    class="cv-video"
    object-fit="contain"
    use-poster="{{true}}"
    controls="{{true}}"
    bindplay="onVideoPlay"
    binderror="onVideoError"
  />

  <!-- 云存储上传 / 外部直链 / 兜底：三者共用同一个 videoUrl，走标准 video 播放。
       注意：txv-video 依赖 app.json 声明插件，未声明时该标签是未注册组件（渲染不出来），
       所以 tencent 档由部署方显式开启后才可能出现（见 scripts/enable-tencent-video.mjs）。
       bindplay 接播放埋点（video_play）：channel-video 官方无播放事件，只有 video 有。 -->
  <video
    wx:elif="{{mode === 'mp4'}}"
    src="{{videoUrl}}"
    class="cv-video"
    object-fit="contain"
    show-fullscreen-btn
    enable-progress-gesture
    bindplay="onVideoPlay"
    binderror="onVideoError"
  />

  <!-- 无视频：封面图左上角叠白色「公司简介」标题；无封面时显示同风格占位（自带标题） -->
  <view wx:elif="{{cover}}" class="cv-wrap">
    <image src="{{cover}}" class="cv" mode="aspectFill" />
    <view class="cv-title">公司简介</view>
  </view>
  <view wx:else class="cv cv-ph">公司简介</view>
</view>
