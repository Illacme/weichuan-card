<view class="rich-video-wrap">
  <!-- MP4 直链（type="mp4"）：标准 video 播放，src 域名在正式版需加入「业务域名」白名单。
       bindplay 接播放埋点（video_play，实例级去重）。
       画幅与首页同源：bindloadedmetadata 拿源文件宽高，onVideoMeta 现场量宽度算出
       行内高度覆盖 WXSS 的 360rpx，配 contain 完整呈现（不裁切、不留黑边）。
       metadata 未到 / 基础库低于 2.7.0 / 量不到宽度时退回 360rpx + contain——
       最多留黑边，绝不裁内容。绝不用 cover 凑满屏。 -->
  <video
    wx:if="{{videoType === 'mp4' && src}}"
    src="{{src}}"
    class="rich-video"
    style="{{mp4BoxStyle}}"
    object-fit="contain"
    bindloadedmetadata="onVideoMeta"
    show-fullscreen-btn
    enable-progress-gesture
    bindplay="onVideoPlay"
    binderror="onVideoError"
  />

  <!-- 腾讯视频（type="tencent"）：插件 vid 取片，原位播放、无视频号角标。
       插件须在 app.json 静态声明（未声明时该标签渲染不出来，块静默消失——
       编辑器侧应提示客户「部署未开启腾讯视频档时勿用」，见组件 ts 文件头）。
       playerid 用实例唯一值（index.ts 的 playerSeq）：富文本一页可能有多个块，
       写死同一个 id 会让多个播放器互相串，哪怕本组件不取 TxvContext。
       **autoplay 显式写 false**：插件这个属性默认是 true（与原生 video 相反），
       不写就是「正文中间突然自己出声」。富文本块没有逐块的播放设置，
       详情页里的视频一律让用户自己点——这是正文，不是视频专区。 -->
  <txv-video
    wx:elif="{{videoType === 'tencent' && vid}}"
    vid="{{vid}}"
    playerid="{{playerId}}"
    autoplay="{{false}}"
    class="rich-video"
    object-fit="contain"
    use-poster="{{true}}"
    controls="{{true}}"
    bindplay="onVideoPlay"
    binderror="onVideoError"
  />

  <!-- 跳转播放（视频号档 + play-mode="redirect"）：wx.openChannelsActivity 打开视频号视频页。
       必须排在 feed-id / feed-token / channel-id 三个内嵌分支**之前**——否则选了跳转的块
       仍会被 channel-video 内嵌播放，客户在后台选的播放方式等于没生效（不报错、只违背配置）。
       块里没有封面可用（富文本块不配封面），所以画一张「在视频号中播放」的卡片当可点区域。 -->
  <view
    wx:elif="{{videoType === 'channels' && playMode === 'redirect' && channelId && feedId}}"
    class="rich-video-jump"
    hover-class="rich-video-jump-down"
    bindtap="onOpenChannels"
  >
    <view class="rich-video-jump-btn"></view>
    <view class="rich-video-jump-tip">在视频号中播放</view>
  </view>

  <!-- 视频号块（无 type / type="channels"，存量内容兼容）：三凭证优先级递减。
       finder-user-name 按官方属性表补上（标必填，与 feed-id 同组）；channelId 为空时值是空串，
       与默认值 "" 等价。三档都挂 bind:error——没有它，块出错就是一个白块 + 控制台全静默，
       客户只会说「详情页那块空白」，运维无从下手。 -->
  <channel-video
    wx:elif="{{feedId}}"
    finder-user-name="{{channelId}}"
    feed-id="{{feedId}}"
    class="rich-video"
    bind:error="onVideoError"
  />

  <!-- 跨主体：feed-id 官方明确仅同主体生效，不同主体必须改用 feed-token。
       代价是强制 autoplay=false（只能显示封面让用户点），故排在同主体之后。
       **不传 finder-user-name**：官方对它写的是「视频号必须与当前小程序相同主体」，
       与 token 档的跨主体语义相悖；token 自身已指明视频号与视频。 -->
  <channel-video
    wx:elif="{{feedToken}}"
    feed-token="{{feedToken}}"
    class="rich-video"
    bind:error="onVideoError"
  />

  <!-- ⚠ 只有 channel-id 的存量块：官方组件文档里**没有**「只传 finder-user-name 就能展示
       视频号主页」这个能力——channel-video 是「视频号视频」组件，没有 feed-id/feed-token
       就等于没有要播的对象，实际表现大概率是空白或报错（本仓从未真机证实过）。
       保留这个分支只是为了让存量块**不至于整块消失**（有报错事件总比块被删掉可诊断），
       不要据此向客户承诺「能展示主页」。真正能看主页的是小程序里另开
       wx.openChannelsUserProfile（与视频播放无关）。 -->
  <channel-video
    wx:elif="{{channelId}}"
    finder-user-name="{{channelId}}"
    class="rich-video"
    bind:error="onVideoError"
  />
</view>
